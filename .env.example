# Browser-safe publishable keys only. Never put sk_*, rk_* or whsec_* in VITE_* variables.
# Keys must come from the same Stripe account/sandbox as the matching Supabase backend.
VITE_STRIPE_PUBLISHABLE_KEY_STAGING=
VITE_STRIPE_PUBLISHABLE_KEY_PRODUCTION=

# The legacy VITE_STRIPE_PUBLISHABLE_KEY is deliberately ignored by Guardian checkout.
# Production checkout remains held in code until full staging verification and a reviewed release.
